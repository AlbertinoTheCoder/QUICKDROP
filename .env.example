# Optional STUN URL. Blank disables public STUN (same-network connections only).
VITE_STUN_URL=stun:stun.l.google.com:19302

# Optional cellular-network relay. These are server-only secrets: NEVER prefix
# them with VITE_. Create a Cloudflare Realtime TURN key to fill these values.
# In Codespaces, put them in .env and restart npm run dev.
# On Cloudflare Pages, set encrypted Variables and Secrets, then redeploy.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
# Choose a private connection code and share it with your friend.
RELAY_ACCESS_CODE=
